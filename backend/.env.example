# =============================================================================
# Swiggy ResolveAI — Backend Environment Configuration Example
# =============================================================================

# Application Metadata
PROJECT_NAME="Swiggy ResolveAI"
VERSION="0.1.0"
ENVIRONMENT="development"  # Options: development, testing, staging, production
LOG_LEVEL="INFO"           # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Execution Mode (Safety Boundary)
# Options:
#   SIMULATION - Fully functional simulated actions, synthetic orders, and virtual recovery (Permitted only in non-production environments)
#   SHADOW     - Passive evaluation on incoming data; recommendations and audits are generated in read-only mode; recovery execution is blocked
#   LIVE       - Customer-facing dispatch (STRICTLY PROHIBITED; fails startup by governance policy)
# NOTE: In production environment, EXECUTION_MODE="SIMULATION" is strictly blocked at startup.
EXECUTION_MODE="SIMULATION"

# Authentication & JWT Security (Bearer Tokens)
# In development/testing, default insecure dev secret may be used.
# In staging/production, AUTH_SECRET_KEY must be changed from the default and have >= 32 characters.
AUTH_SECRET_KEY="resolveai-insecure-dev-secret-key-change-in-production-12345678"
AUTH_ALGORITHM="HS256"
AUTH_ISSUER="swiggy-resolveai"
AUTH_AUDIENCE="resolveai-ops"
AUTH_TOKEN_EXPIRE_MINUTES=120

# Database Configuration
# For local SQLite development (default):
DATABASE_URL=sqlite:///./resolveai.db

# For PostgreSQL (Docker Compose / Staging / Production):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/resolveai

# Database Connection Pooling (Applies to PostgreSQL only; ignored by SQLite)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# CORS Allowed Origins (Comma-separated in production)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Request Timeout
REQUEST_TIMEOUT_SECONDS=30.0

# Gemini API Integration (Optional: fallback engine is automatically used if empty or omitted)
# Obtain via Google AI Studio: https://aistudio.google.com/
# GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL_NAME=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=10.0

# ML Artifact Directory Path
ML_ARTIFACTS_DIR=data/artifacts/models/phase_2_5
