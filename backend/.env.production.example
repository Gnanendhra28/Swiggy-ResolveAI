# =============================================================================
# Swiggy ResolveAI — Backend Production Environment Variables Template
# Set these variables in your backend hosting dashboard (Render, Railway, etc.)
# =============================================================================

# Application Metadata
PROJECT_NAME="Swiggy ResolveAI"
VERSION="0.1.0"
ENVIRONMENT=production
LOG_LEVEL=INFO

# Execution Mode (Safety Boundary)
# In production, EXECUTION_MODE must be set to "SHADOW".
# Setting "SIMULATION" in production causes a fatal startup failure.
# Setting "LIVE" causes a fatal startup failure across all environments.
EXECUTION_MODE=SHADOW

# Authentication & JWT Security (Bearer Tokens)
# Generate a cryptographically secure 64-char hex string (min 32 chars):
# Run in terminal: openssl rand -hex 32
AUTH_SECRET_KEY=YOUR_GENERATED_AUTH_SECRET
AUTH_ALGORITHM=HS256
AUTH_ISSUER=swiggy-resolveai
AUTH_AUDIENCE=resolveai-ops
AUTH_TOKEN_EXPIRE_MINUTES=120

# Database Configuration (Hosted PostgreSQL 15+)
# Example: postgresql+psycopg2://<user>:<password>@<host>:5432/<dbname>?sslmode=require
DATABASE_URL=YOUR_HOSTED_POSTGRESQL_URL

# Database Connection Pooling (PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# CORS Allowed Origins
# Comma-separated HTTPS origins of your deployed Vercel frontend
# Example: https://swiggy-resolveai.vercel.app
BACKEND_CORS_ORIGINS=https://YOUR_VERCEL_FRONTEND_URL

# Request Timeout
REQUEST_TIMEOUT_SECONDS=30.0

# Google Gemini API Integration (Optional: fallback engine is automatically used if omitted)
# Obtain via Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL_NAME=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=10.0

# ML Artifact Directory Path (Inside container)
ML_ARTIFACTS_DIR=data/artifacts/models/phase_2_5
