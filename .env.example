# ResolveAI Environment Configuration Example

# Project Info
PROJECT_NAME="Swiggy ResolveAI"
VERSION="0.1.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=resolveai
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/resolveai

# Fallback for standalone local development without PostgreSQL running:
# DATABASE_URL=sqlite:///./resolveai.db

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
