# =============================================================================
# Swiggy ResolveAI — Root Local Development Environment Configuration
# Copy this file to .env for local full-stack development
# =============================================================================

# Project Metadata
PROJECT_NAME="Swiggy ResolveAI"
VERSION="0.1.0"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Execution Mode (SIMULATION permitted for local development)
EXECUTION_MODE=SIMULATION

# Authentication (Development secret — automatically rejected in production)
AUTH_SECRET_KEY="resolveai-insecure-dev-secret-key-change-in-production-12345678"
AUTH_ALGORITHM=HS256
AUTH_ISSUER=swiggy-resolveai
AUTH_AUDIENCE=resolveai-ops
AUTH_TOKEN_EXPIRE_MINUTES=120

# Database Configuration
# Default: Standalone SQLite database for zero-dependency local development
DATABASE_URL=sqlite:///./resolveai.db

# Alternative: Local Docker Compose PostgreSQL (run: docker compose up -d postgres)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/resolveai

# Frontend API URL (Consumed by Next.js in local development)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
BACKEND_URL=http://localhost:8000

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Google Gemini API (Optional: deterministic rule fallback automatically used if omitted)
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL_NAME=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=10.0
