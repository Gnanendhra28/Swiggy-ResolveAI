# =============================================================================
# Swiggy ResolveAI — Vercel Production Environment Variables Template
# Set these variables in the Vercel Dashboard:
# Project Settings -> Environment Variables -> Production & Preview
# =============================================================================

# Public Backend Gateway Base URL
# Must point to your deployed backend HTTPS API endpoint.
# Example: https://swiggy-resolveai-api.onrender.com/api/v1
NEXT_PUBLIC_API_URL=https://YOUR_DEPLOYED_BACKEND_URL/api/v1

# Internal Server-Side Backend URL
# Target URL used by Next.js server-side rewrites (/api/:path*) in frontend/next.config.ts
# Example: https://swiggy-resolveai-api.onrender.com
BACKEND_URL=https://YOUR_DEPLOYED_BACKEND_URL
