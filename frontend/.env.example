# =============================================================================
# Swiggy ResolveAI — Frontend Local Development Configuration Example
# Copy this file to frontend/.env.local for local frontend development
# =============================================================================

# Public Backend Gateway Base URL (Consumed by client-side browser fetch calls)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Internal / Server-Side Backend URL (Consumed by Next.js server-side rewrites and SSR)
BACKEND_URL=http://127.0.0.1:8000
